+// Keep initialization independent of DDS discovery and controller loading latency.
+void HoldStartupState(mjModel* model, mjData* data) {
+  if (!startup_ready.load() && startup_qpos.size() == static_cast<size_t>(model->nq)) {
+    mju_copy(data->qpos, startup_qpos.data(), model->nq);
+    mju_zero(data->qvel, model->nv);
+    mj_forward(model, data);
+  }
